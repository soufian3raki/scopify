---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  recipe: CollectionEntry<'rezepte'>;
  variant?: 'hero' | 'thumb' | 'card';
}

const { recipe, variant = 'thumb' } = Astro.props;
const { cover, thumb, thumbClass, title } = recipe.data;

const sizes = {
  hero: { width: 960, height: 1200 },
  thumb: { width: 240, height: 240 },
  card: { width: 640, height: 640 },
} as const;

const { width, height } = sizes[variant];
---

{cover ? (
  <Image
    src={cover}
    alt={title}
    width={width}
    height={height}
    class={`recipe-cover recipe-cover--${variant}`}
    loading={variant === 'hero' ? 'eager' : 'lazy'}
  />
) : (
  <div class:list={['recipe-cover-fallback', `recipe-cover-fallback--${variant}`, thumbClass]}>
    <span class="recipe-cover-emoji">{thumb}</span>
  </div>
)}

<style>
.recipe-cover {
  display: block;
  object-fit: contain;
  background: var(--brand-secondary, #f5eeda);
}
.recipe-cover--hero {
  width: 100%;
  height: auto;
  max-height: 70vh;
}
.recipe-cover--thumb {
  width: 96px;
  height: 96px;
  border-radius: 14px;
  flex-shrink: 0;
}
.recipe-cover--card {
  width: 100%;
  height: auto;
  max-height: 220px;
}

.recipe-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand-accent, #e1ab7b), var(--brand-dark, #87674a));
}
.recipe-cover-fallback--hero {
  width: 100%;
  min-height: 280px;
}
.recipe-cover-fallback--thumb {
  width: 96px;
  height: 96px;
  border-radius: 14px;
  flex-shrink: 0;
}
.recipe-cover-fallback--card {
  width: 100%;
  min-height: 160px;
}
.recipe-cover-fallback.t2 { background: linear-gradient(135deg, #f5eeda, #e1ab7b); }
.recipe-cover-fallback.t3 { background: linear-gradient(135deg, #e1ab7b, #591727); }
.recipe-cover-fallback.t4 { background: linear-gradient(135deg, #f5eeda, #87674a); }
.recipe-cover-fallback.t5 { background: linear-gradient(135deg, #87674a, #591727); }
.recipe-cover-fallback.t6 { background: linear-gradient(135deg, #e1ab7b, #87674a); }
.recipe-cover-fallback.f2 { background: linear-gradient(135deg, #f5eeda, #e1ab7b); }
.recipe-cover-fallback.f3 { background: linear-gradient(135deg, #e1ab7b, #591727); }
.recipe-cover-fallback.f4 { background: linear-gradient(135deg, #f5eeda, #87674a); }

.recipe-cover-emoji { line-height: 1; filter: drop-shadow(0 4px 12px rgba(0, 0, 0, .2)); }
.recipe-cover-fallback--hero .recipe-cover-emoji { font-size: 120px; filter: drop-shadow(0 8px 20px rgba(0, 0, 0, .3)); }
.recipe-cover-fallback--thumb .recipe-cover-emoji { font-size: 36px; }
</style>
