<section class="tb-subscribe">
  <h2 class="tb-subscribe-title">Subscribe for free recipes &amp; guides</h2>
  <p class="tb-subscribe-lead">
    Plus your welcome gift: a <strong>10% Amazon code</strong> and the Trustbread sourdough recipe book (PDF).
  </p>

  <div id="subscribeForm">
    <div class="tb-subscribe-row">
      <input id="subscribeEmail" type="email" placeholder="Enter your email" autocomplete="email" />
      <button type="button" id="subscribeBtn">Become a VIP</button>
    </div>
    <p class="tb-subscribe-error is-hidden" id="subscribeError"></p>
    <p class="tb-subscribe-note">By signing up you accept our <strong>privacy policy</strong>. Unsubscribe anytime.</p>
  </div>

  <div class="tb-subscribe-success is-hidden" id="subscribeSuccess">
    <div class="tb-subscribe-success-title">✓ Please confirm your email</div>
    <p class="tb-subscribe-success-text">We’ve sent you a confirmation email. Your 10% code and recipe book will arrive right after.</p>
  </div>
</section>

<style>
.tb-subscribe {
  display: none;
  margin-top: 28px;
  background: var(--tb-orange);
  padding: 26px 22px 30px;
}
.tb-subscribe-title {
  font-family: var(--font-display);
  font-size: 30px;
  line-height: 1;
  color: var(--tb-burgundy);
  text-transform: uppercase;
  font-weight: 400;
}
.tb-subscribe-lead {
  font-size: 13.5px;
  line-height: 1.55;
  color: #5C3A28;
  margin-top: 8px;
}
.tb-subscribe-row {
  display: flex;
  align-items: center;
  background: var(--tb-card);
  border-radius: 999px;
  padding: 5px 5px 5px 18px;
  margin-top: 14px;
}
.tb-subscribe-row input {
  flex: 1;
  min-width: 0;
  border: none;
  background: transparent;
  font-size: 14.5px;
  color: var(--tb-ink);
  outline: none;
  padding: 10px 0;
  font-family: var(--font-body);
}
.tb-subscribe-row button {
  flex: none;
  background: var(--tb-burgundy);
  color: var(--tb-cream);
  font-size: 14px;
  font-weight: 700;
  border: none;
  border-radius: 999px;
  padding: 11px 18px;
  cursor: pointer;
  font-family: var(--font-body);
}
.tb-subscribe-row button:active { background: var(--brand-light-1); }
.tb-subscribe-error {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--tb-burgundy);
  margin-top: 8px;
}
.tb-subscribe-note {
  font-size: 12px;
  color: #5C3A28;
  margin-top: 10px;
}
.tb-subscribe-success {
  background: var(--tb-card);
  border-radius: 12px;
  padding: 16px;
  margin-top: 14px;
}
.tb-subscribe-success-title {
  font-family: var(--font-display);
  font-size: 19px;
  color: var(--tb-burgundy);
  text-transform: uppercase;
  line-height: 1.05;
  font-weight: 400;
}
.tb-subscribe-success-text {
  font-size: 13px;
  line-height: 1.5;
  color: var(--tb-ink-soft);
  margin-top: 4px;
}
</style>

<script>
  const emailInput = document.getElementById('subscribeEmail') as HTMLInputElement | null;
  const submitBtn = document.getElementById('subscribeBtn');
  const form = document.getElementById('subscribeForm');
  const success = document.getElementById('subscribeSuccess');
  const errorEl = document.getElementById('subscribeError');

  submitBtn?.addEventListener('click', () => {
    const email = emailInput?.value.trim() ?? '';
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      errorEl?.classList.remove('is-hidden');
      if (errorEl) errorEl.textContent = 'Please enter a valid email address.';
      return;
    }
    errorEl?.classList.add('is-hidden');
    form?.classList.add('is-hidden');
    success?.classList.remove('is-hidden');
  });

  emailInput?.addEventListener('input', () => errorEl?.classList.add('is-hidden'));
</script>
