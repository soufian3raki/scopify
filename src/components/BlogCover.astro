---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'hero' | 'card';
}

const { post, variant = 'card' } = Astro.props;
const { cover, imgClass, title } = post.data;

const sizes = {
  hero: { width: 960, height: 440 },
  card: { width: 400, height: 320 },
} as const;

const { width, height } = sizes[variant];
---

{cover ? (
  <Image
    src={cover}
    alt={title}
    width={width}
    height={height}
    class={`blog-cover blog-cover--${variant}`}
    loading={variant === 'hero' ? 'eager' : 'lazy'}
  />
) : (
  <div class:list={['blog-cover-fallback', `blog-cover-fallback--${variant}`, imgClass]} />
)}

<style>
.blog-cover {
  display: block;
  object-fit: cover;
}
.blog-cover--hero {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.blog-cover--card {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.blog-cover-fallback {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #e1ab7b, #87674a);
}
.blog-cover-fallback.b2 { background: linear-gradient(135deg, #87674a, #591727); }
.blog-cover-fallback.b3 { background: linear-gradient(135deg, #e1ab7b, #591727); }
.blog-cover-fallback.b4 { background: linear-gradient(135deg, #591727, #3d0f1a); }
</style>
