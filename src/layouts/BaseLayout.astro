---
import '../styles/global.css';

export interface Props {
  title?: string;
  activeNav?: string;
  showNav?: boolean;
  noBottomPad?: boolean;
  showHeader?: boolean;
}

const { 
  title = 'Trustbread — Your Sourdough App', 
  activeNav = '', 
  showNav = true,
  noBottomPad = false,
  showHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#f5eeda" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <title>{title}</title>
</head>
<body>
  <div class="app" class:list={[{ 'no-pad': noBottomPad, 'with-header': showHeader }]}>
    <slot />
  </div>

  {showNav && (
    <nav class="bottom-nav" aria-label="Main">
      <a href="/home/" class:list={['nav-item', { active: activeNav === 'home' }]}>
        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M3 9.5L10 3L17 9.5V17H12V12H8V17H3V9.5Z" stroke-linejoin="round"/>
        </svg>
        <span class="nav-label">Home</span>
      </a>
      <a href="/rezepte/" class:list={['nav-item', { active: activeNav === 'recipes' }]}>
        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M10 4C8.5 2.8 6 2.8 3.5 3.5V16C6 15.3 8.5 15.3 10 16.5C11.5 15.3 14 15.3 16.5 16V3.5C14 2.8 11.5 2.8 10 4Z" stroke-linejoin="round"/>
          <path d="M10 4V16.5"/>
        </svg>
        <span class="nav-label">Recipes</span>
      </a>
      <a href="/shop/" class:list={['nav-item', { active: activeNav === 'shop' }]}>
        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M5 6H15L16.2 16.5H3.8L5 6Z" stroke-linejoin="round"/>
          <path d="M7 8V5.5C7 3.8 8.3 2.5 10 2.5C11.7 2.5 13 3.8 13 5.5V8" stroke-linecap="round"/>
        </svg>
        <span class="nav-label">Shop</span>
      </a>
      <a href="/blog/" class:list={['nav-item', { active: activeNav === 'blog' }]}>
        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M4 4H16V13H8L4 16.5V4Z" stroke-linejoin="round"/>
        </svg>
        <span class="nav-label">Blog</span>
      </a>
      <a href="/profil/" class:list={['nav-item', { active: activeNav === 'profile' }]}>
        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="10" cy="6.5" r="3.2"/>
          <path d="M3.5 17C4.3 13.8 7 12.3 10 12.3C13 12.3 15.7 13.8 16.5 17" stroke-linecap="round"/>
        </svg>
        <span class="nav-label">Profile</span>
      </a>
    </nav>
  )}

  <script>
    import '../scripts/native-shell.ts';
  </script>
</body>
</html>

