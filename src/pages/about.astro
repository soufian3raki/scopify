---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="History of Sourdough — Superbaking" showNav={false}>
    <div class="fade-in">
        <div class="page-head">
            <a href="/home/" class="page-back">←</a>
            <div class="page-title">Your first sourdough should feel proud, not perfect</div>
            <p class="page-sub">
                Beautiful, honest tools for real beginners. Handmade rattan, zero intimidation, family-table results.
            </p>
        </div>
        <div class="page-content">
            <img src="/img/about/ChatGPT Image Jul 16, 2026, 06_02_42 AM.png" alt="History of Sourdoughpage-content">
            <img src="/img/about/ChatGPT Image Jul 16, 2026, 05_54_45 AM.png" alt="History of Sourdoughpage-content">
            <img src="/img/about/ChatGPT Image Jul 16, 2026, 05_56_44 AM.png" alt="History of Sourdoughpage-content">
            <img src="/img/about/ChatGPT Image Jul 16, 2026, 05_51_53 AM.png" alt="History of Sourdoughpage-content">
            <img src="/img/about/ChatGPT Image Jul 16, 2026, 05_46_04 AM.png" alt="History of Sourdoughpage-content">
        </div>
    </div>
</BaseLayout>

<style>
    .page-content {
        padding: 0 var(--page-pad-x) 32px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }
    img {
        width: 100%;
    }
</style>
