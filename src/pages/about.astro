---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="History of Sourdough — Superbaking" showNav={false}>
    <div class="fade-in">
        <div class="page-head">
            <a href="/home" class="page-back">←</a>
            <div class="page-title">Your first sourdough should feel proud, not perfect</div>
            <p class="page-sub">
                Beautiful, honest tools for real beginners. Handmade rattan, zero intimidation, family-table results.
            </p>
        </div>
        <div class="page-content">
            <img src="/src/img/about/ChatGPT%20Image%20Jul%2016,%202026,%2006_02_42%20AM.png" alt="History of Sourdoughpage-content">
            <img src="/src/img/about/ChatGPT%20Image%20Jul%2016,%202026,%2005_54_45%20AM.png" alt="History of Sourdoughpage-content">
            <img src="/src/img/about/ChatGPT%20Image%20Jul%2016,%202026,%2005_56_44%20AM.png" alt="History of Sourdoughpage-content">
            <img src="/src/img/about/ChatGPT%20Image%20Jul%2016,%202026,%2005_51_53%20AM.png" alt="History of Sourdoughpage-content">
            <img src="/src/img/about/ChatGPT%20Image%20Jul%2016,%202026,%2005_46_04%20AM.png" alt="History of Sourdoughpage-content">
        </div>
    </div>
</BaseLayout>

<style>
    .page-content {
        padding: 0 var(--page-pad-x) 32px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }
    img {
        width: 100%;
    }
</style>
