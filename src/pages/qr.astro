---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Open Trustbread" showNav={false} noBottomPad={true}>
  <div class="qr-page fade-in">
    <div class="qr-card" id="qr-card">
      <img src="/favicon.png" alt="Trustbread" class="qr-logo" width="96" height="96" />
      <h1 class="qr-title">Trustbread</h1>
      <p class="qr-sub" id="qr-status">Detecting your device…</p>

      <ol class="qr-steps" id="qr-steps" hidden></ol>

      <button type="button" class="qr-cta" id="qr-cta" hidden>
        Continue
      </button>

      <p class="qr-hint" id="qr-hint" hidden></p>

      <a class="qr-skip" id="qr-skip" href="/home/">Open in browser →</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { Capacitor } from '@capacitor/core';

  type DeferredPrompt = Event & {
    prompt: () => Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  };

  const cardEl = document.getElementById('qr-card')!;
  const statusEl = document.getElementById('qr-status')!;
  const stepsEl = document.getElementById('qr-steps') as HTMLOListElement;
  const ctaEl = document.getElementById('qr-cta') as HTMLButtonElement;
  const hintEl = document.getElementById('qr-hint')!;
  const skipEl = document.getElementById('qr-skip') as HTMLAnchorElement;
  const APP_URL = '/home/';
  const INSTALLED_KEY = 'tb_pwa_installed';

  function isMobile(): boolean {
    const ua = navigator.userAgent || '';
    const touch = navigator.maxTouchPoints > 1;
    const mobileUa = /Android|iPhone|iPad|iPod|Mobile|webOS|BlackBerry|IEMobile|Opera Mini/i.test(ua);
    const iPadDesktop = /Macintosh/i.test(ua) && touch;
    return mobileUa || iPadDesktop;
  }

  function isIos(): boolean {
    return (
      /iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      (/Macintosh/i.test(navigator.userAgent) && navigator.maxTouchPoints > 1)
    );
  }

  function isAndroid(): boolean {
    return /Android/i.test(navigator.userAgent);
  }

  function isStandalone(): boolean {
    return (
      window.matchMedia('(display-mode: standalone)').matches ||
      // @ts-expect-error iOS Safari
      window.navigator.standalone === true
    );
  }

  function deviceKind(): 'ios' | 'android' | 'desktop' {
    if (isIos()) return 'ios';
    if (isAndroid()) return 'android';
    return 'desktop';
  }

  async function registerSw() {
    if (!('serviceWorker' in navigator)) return;
    try {
      await navigator.serviceWorker.register('/sw.js');
    } catch {
      // ignore
    }
  }

  function openApp() {
    window.location.assign(APP_URL);
  }

  function setSteps(items: string[]) {
    stepsEl.innerHTML = '';
    for (const text of items) {
      const li = document.createElement('li');
      li.innerHTML = text;
      stepsEl.appendChild(li);
    }
    stepsEl.hidden = items.length === 0;
  }

  /** Success screen after the web app is installed */
  function showInstalled() {
    try {
      localStorage.setItem(INSTALLED_KEY, '1');
    } catch {
      // ignore
    }

    cardEl.classList.add('is-installed');
    statusEl.textContent = 'Trustbread is installed ✓';
    hintEl.hidden = false;
    skipEl.hidden = true;

    const kind = deviceKind();

    if (kind === 'ios') {
      hintEl.textContent = 'Look for the Trustbread icon on your Home Screen.';
      setSteps([
        'Leave Safari and go to your <strong>Home Screen</strong> (press the home button or swipe up).',
        'Find the black <strong>Trustbread</strong> icon among your apps.',
        'Tap it anytime to open the app like a native app.',
        'Tip: press and hold the icon to move it to your Dock for quicker access.',
      ]);
    } else if (kind === 'android') {
      hintEl.textContent = 'You can open Trustbread from your Home screen or app drawer.';
      setSteps([
        'Go to your phone’s <strong>Home screen</strong> or open the <strong>App drawer</strong> (swipe up on home).',
        'Look for the <strong>Trustbread</strong> icon.',
        'Tap it to open — it runs full screen without the browser bar.',
        'Tip: press and hold the icon → <strong>Add to Home</strong> or pin it to your favorites if it is only in the drawer.',
      ]);
    } else {
      hintEl.textContent = 'Open Trustbread from your computer like any other app.';
      setSteps([
        '<strong>Windows:</strong> open the Start menu and search for <strong>Trustbread</strong>, or check the desktop / taskbar.',
        '<strong>Mac:</strong> open Launchpad or Applications and look for <strong>Trustbread</strong>.',
        'You can also pin it to the taskbar (Windows) or Dock (Mac) for next time.',
      ]);
    }

    ctaEl.hidden = false;
    ctaEl.textContent = 'Open Trustbread now';
    ctaEl.onclick = () => openApp();
  }

  let deferredPrompt: DeferredPrompt | null = null;
  let mode: 'install' | 'open' | 'ios-guide' | 'installed' = 'open';

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e as DeferredPrompt;
    if (isMobile() && !isStandalone() && mode !== 'installed') {
      mode = 'install';
      statusEl.textContent = 'Install Trustbread on your phone';
      ctaEl.hidden = false;
      ctaEl.textContent = 'Install web app';
      hintEl.hidden = true;
      setSteps([]);
    }
  });

  window.addEventListener('appinstalled', () => {
    deferredPrompt = null;
    mode = 'installed';
    showInstalled();
  });

  ctaEl.addEventListener('click', async () => {
    if (mode === 'installed') {
      openApp();
      return;
    }

    if (deferredPrompt && mode === 'install') {
      await deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (outcome === 'accepted') {
        mode = 'installed';
        // appinstalled usually fires; show success even if it is delayed
        showInstalled();
      } else {
        statusEl.textContent = 'Install cancelled';
        hintEl.hidden = false;
        hintEl.textContent = 'You can try again, or open Trustbread in the browser.';
        ctaEl.textContent = 'Try install again';
        mode = 'install';
      }
      return;
    }

    if (mode === 'ios-guide') {
      // User confirms they added it to the Home Screen
      mode = 'installed';
      showInstalled();
      return;
    }

    openApp();
  });

  async function boot() {
    if (Capacitor.isNativePlatform()) {
      openApp();
      return;
    }

    await registerSw();

    // Already running as installed PWA
    if (isStandalone()) {
      statusEl.textContent = 'Opening Trustbread…';
      openApp();
      return;
    }

    // Returning after a previous install (not yet opened as standalone)
    try {
      if (localStorage.getItem(INSTALLED_KEY) === '1' && isMobile()) {
        mode = 'installed';
        showInstalled();
        return;
      }
    } catch {
      // ignore
    }

    if (!isMobile()) {
      mode = 'open';
      statusEl.textContent = 'Opening Trustbread on your computer…';
      ctaEl.hidden = false;
      ctaEl.textContent = 'Open app';
      hintEl.hidden = true;
      setTimeout(openApp, 900);
      return;
    }

    if (isIos()) {
      mode = 'ios-guide';
      statusEl.textContent = 'Install Trustbread on your iPhone / iPad';
      ctaEl.hidden = false;
      ctaEl.textContent = 'I’ve added it to Home Screen';
      hintEl.hidden = false;
      hintEl.textContent = 'Follow the steps below, then tap the button.';
      setSteps([
        'Tap the <strong>Share</strong> button in Safari (square with an arrow).',
        'Scroll and tap <strong>Add to Home Screen</strong>.',
        'Confirm with <strong>Add</strong>.',
        'Then tap <strong>I’ve added it to Home Screen</strong> below.',
      ]);
      skipEl.textContent = 'Open in Safari instead →';
      return;
    }

    // Android / other
    statusEl.textContent = 'Preparing install…';
    setTimeout(() => {
      if (deferredPrompt || mode === 'installed') return;
      mode = 'install';
      statusEl.textContent = 'Install Trustbread on your phone';
      ctaEl.hidden = false;
      ctaEl.textContent = 'Install web app';
      hintEl.hidden = false;
      hintEl.textContent =
        'If the install button does not appear, open the browser menu (⋮) → Install app / Add to Home screen.';
      setSteps([
        'Tap <strong>Install web app</strong> when prompted, or use the browser menu.',
        'Accept the install dialog.',
        'Afterwards we will show you exactly where to find Trustbread.',
      ]);
    }, 1200);
  }

  boot();
</script>

<style>
  .qr-page {
    min-height: 100%;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(24px + env(safe-area-inset-top, 0px)) var(--page-pad-x)
      calc(24px + env(safe-area-inset-bottom, 0px));
    background:
      radial-gradient(circle at 80% 10%, rgba(225, 171, 123, 0.22), transparent 50%),
      radial-gradient(circle at 15% 90%, rgba(89, 23, 39, 0.1), transparent 45%),
      linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
  }
  .qr-card {
    width: min(100%, 400px);
    text-align: center;
  }
  .qr-card.is-installed .qr-logo {
    box-shadow: 0 0 0 3px var(--brand-accent), var(--shadow-lg);
  }
  .qr-logo {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    object-fit: cover;
    box-shadow: var(--shadow-lg);
    margin: 0 auto 20px;
    display: block;
    background: #000;
  }
  .qr-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 8vw, 36px);
    color: var(--ink);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: 10px;
  }
  .qr-sub {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .qr-steps {
    text-align: left;
    margin: 0 0 22px;
    padding: 16px 16px 16px 36px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: 18px;
    list-style: decimal;
  }
  .qr-steps li {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-2);
    margin-bottom: 10px;
  }
  .qr-steps li:last-child {
    margin-bottom: 0;
  }
  .qr-steps strong {
    color: var(--ink);
  }
  .qr-cta {
    appearance: none;
    border: none;
    width: 100%;
    padding: 16px 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }
  .qr-cta:active {
    transform: scale(0.98);
  }
  .qr-hint {
    margin-top: 18px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }
  .qr-skip {
    display: inline-block;
    margin-top: 22px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
</style>
