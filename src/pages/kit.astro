---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  { icon: '🧺', name: 'Rattan Proofing Basket (Banneton)', desc: 'Hand-woven from Indonesian rattan. Gives your bread shape and the classic spiral pattern.', importance: 'essential', label: 'Essential' },
  { icon: '⚖️', name: 'Digital Kitchen Scale', desc: 'Precise to 1g. Sourdough needs exact baker\'s percentages.', importance: 'essential', label: 'Essential' },
  { icon: '🔪', name: 'Dough Scraper (Metal)', desc: 'With wooden handle. Divides dough cleanly and lifts it from the work surface.', importance: 'essential', label: 'Essential' },
  { icon: '🪒', name: 'Lame (Baker\'s Blade)', desc: 'With replacement blades for the perfect ear when scoring.', importance: 'essential', label: 'Essential' },
  { icon: '🥄', name: 'Bowl Scraper', desc: 'Flexible silicone. Scrapes the bowl completely clean.', importance: 'helpful', label: 'Helpful' },
  { icon: '🌀', name: 'Dough Whisk', desc: 'Danish-style whisk. Mixes stiff dough without lumps.', importance: 'helpful', label: 'Helpful' },
  { icon: '🖌️', name: 'Pastry Brush', desc: 'For water, egg wash, or flour on the finished loaf.', importance: 'optional', label: 'Optional' },
];
---

<BaseLayout title="My Kit — Superbaking" showNav={false}>
  <div class="fade-in">

    <div class="page-head">
      <a href="/home" class="page-back">←</a>
      <div class="page-title">My Kit</div>
      <p class="page-sub">All 7 tools from your starter kit explained.</p>
    </div>

    <div class="kit-grid">
      {tools.map(t => (
        <div class="kit-card">
          <div class="kit-icon">{t.icon}</div>
          <div class="kit-info">
            <div class="kit-name">{t.name}</div>
            <div class="kit-desc">{t.desc}</div>
            <span class:list={['kit-importance', t.importance]}>{t.label}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
.kit-grid { padding: 0 var(--page-pad-x) 32px; display: grid; grid-template-columns: 1fr; gap: 14px; }
.kit-card { display: flex; gap: 14px; padding: 16px; background: var(--paper); border: 1px solid var(--line); border-radius: 18px; }
.kit-icon {
  width: 64px; height: 64px; border-radius: 14px; flex-shrink: 0;
  background: linear-gradient(135deg, var(--yeast), var(--crust));
  display: flex; align-items: center; justify-content: center; font-size: 30px;
}
.kit-info { flex: 1; }
.kit-name { font-family: var(--font-display); font-size: var(--font-size); line-height: var(--line-height); font-weight: var(--font-weight); color: var(--ink); margin-bottom: 4px; letter-spacing: 0.02em; }
.kit-desc { font-size: 12px; color: var(--ink-2); line-height: 1.4; margin-bottom: 8px; }
.kit-importance { display: inline-block; padding: 3px 10px; border-radius: 100px; font-size: 10px; font-weight: var(--font-weight); text-transform: uppercase; letter-spacing: .08em; }
.kit-importance.essential { background: color-mix(in srgb, var(--burgundy) 12%, var(--cream)); color: var(--red); }
.kit-importance.helpful { background: color-mix(in srgb, var(--brown) 12%, var(--cream)); color: var(--green); }
.kit-importance.optional { background: color-mix(in srgb, var(--sand) 25%, var(--cream)); color: var(--brown); }
</style>
