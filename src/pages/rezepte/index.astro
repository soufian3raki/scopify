---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCover from '../../components/RecipeCover.astro';
import { buildRecipeSearchText, parseTimeHours } from '../../lib/recipe-filters';
import { isEnabled } from '../../config/feature-flags';
import { formatDifficulty } from '../../lib/recipe-meta';

const recipes = (await getCollection('rezepte')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'en')
);
---

<BaseLayout title="All Recipes — Superbaking" activeNav="recipes">
  <div class="fade-in">

    <div class="head">
      <div>
        <div class="head-greet">Browse</div>
        <div class="head-name">All Recipes</div>
      </div>
      <a href="/profil/" class="head-avatar">B</a>
    </div>

    <div class="search-bar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input id="recipeSearch" type="search" placeholder="Search recipes, ingredients..." autocomplete="off" />
    </div>

    <div class="filter-chips" id="recipeFilters">
      <button type="button" class="chip active" data-filter="all">All</button>
      <button type="button" class="chip" data-filter="beginner">Beginner</button>
      <button type="button" class="chip" data-filter="quick">Quick &lt;6h</button>
      <button type="button" class="chip" data-filter="rye">Rye</button>
      {isEnabled('recipeFilterGlutenfrei') && (
        <button type="button" class="chip" data-filter="glutenfree">Gluten-free</button>
      )}
      <button type="button" class="chip" data-filter="sweet">Sweet</button>
    </div>

    <p class="list-empty is-hidden" id="recipeEmpty">No recipes found.</p>

    <div class="recipe-list" id="recipeList">
      {recipes.map((recipe) => {
        const searchText = buildRecipeSearchText(
          recipe.data.title,
          recipe.data.description,
          recipe.data.category,
          recipe.data.difficulty,
          recipe.data.tag,
          recipe.data.ingredients
        );
        return (
          <a
            href={`/rezepte/${recipe.slug}/`}
            class="recipe-row"
            data-search={searchText}
            data-category={recipe.data.category}
            data-difficulty={recipe.data.difficulty}
            data-time-hours={parseTimeHours(recipe.data.times.total)}
          >
            <RecipeCover recipe={recipe} variant="thumb" />
            <div class="recipe-info">
              <div>
                <div class="recipe-cat">{recipe.data.category}</div>
                <div class="recipe-name">{recipe.data.title}</div>
              </div>
              <div class="recipe-tags">
                <span>⏱ {recipe.data.times.total}</span>
                <span>{formatDifficulty(recipe.data.difficulty)}</span>
                <span>🍞 {recipe.data.yield}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</BaseLayout>

<style>
.search-bar {
  margin: 0 var(--page-pad-x) 16px; padding: 14px 18px; background: var(--paper);
  border-radius: 100px; border: 1px solid var(--line);
  display: flex; align-items: center; gap: 10px;
}
.search-bar input {
  border: none; background: transparent; flex: 1; font-size: 14px;
  font-family: inherit; outline: none; color: var(--ink);
}
.search-bar input::-webkit-search-cancel-button { cursor: pointer; }
.filter-chips { display: flex; gap: 8px; padding: 0 var(--page-pad-x) 16px; overflow-x: auto; }
.filter-chips::-webkit-scrollbar { display: none; }
.recipe-list { padding: 0 var(--page-pad-x) 24px; display: flex; flex-direction: column; gap: 14px; }
.recipe-row {
  display: flex; gap: 14px; padding: 12px; border-radius: 18px;
  background: var(--paper); border: 1px solid var(--line); cursor: pointer;
  transition: transform .2s, opacity .2s; text-decoration: none;
}
.recipe-row:active { transform: scale(.98); }
.recipe-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 2px 0; }
.recipe-cat { font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: var(--accent); font-weight: var(--font-weight); margin-bottom: 4px; }
.recipe-name {
  font-family: var(--font-display);
  font-size: 22px;
  line-height: 1.15;
  font-weight: var(--font-weight);
  color: var(--ink);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}
.recipe-tags { display: flex; gap: 10px; font-size: 11px; color: var(--muted); margin-top: 6px; }
.recipe-tags span { display: flex; align-items: center; gap: 3px; }
</style>

<script>
  import { initListFilter } from '../../scripts/list-filter.ts';
  import { matchesRecipeFilter } from '../../lib/recipe-filters.ts';

  initListFilter({
    searchInputId: 'recipeSearch',
    filterContainerId: 'recipeFilters',
    listContainerId: 'recipeList',
    emptyStateId: 'recipeEmpty',
    itemSelector: '.recipe-row',
    getSearchText: (item) => item.dataset.search ?? '',
    matchesFilter: (filter, item) =>
      matchesRecipeFilter(
        filter,
        item.dataset.category ?? '',
        item.dataset.difficulty ?? '',
        Number(item.dataset.timeHours ?? 999),
        item.dataset.search ?? ''
      ),
  });
</script>
