---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import imgHero from '../img/kit/ChatGPT Image Jul 7, 2026, 03_34_30 AM.png';
import imgScale from '../img/kit/ChatGPT Image Jul 7, 2026, 03_37_49 AM.png';
import imgBanneton from '../img/kit/ChatGPT Image Jul 7, 2026, 03_51_48 AM.png';
import imgScraper from '../img/kit/ChatGPT Image Jul 8, 2026, 03_19_36 PM.png';
import imgWhisk from '../img/kit/ChatGPT Image Jul 8, 2026, 04_05_41 AM.png';
import imgGift from '../img/kit/ChatGPT Image Jul 9, 2026, 12_24_25 AM.png';
import imgSteps from '../img/kit/ChatGPT Image Jul 10, 2026, 06_21_34 PM.png';
import imgLifestyle from '../img/kit/ChatGPT Image Jul 10, 2026, 07_03_25 PM.png';
import imgLame from '../img/kit/ChatGPT Image Jul 11, 2026, 04_56_07 PM.png';

const amazonUrl = 'https://www.amazon.com/5as_url_amazon'

const gallery: { src: ImageMetadata; alt: string }[] = [
  { src: imgHero, alt: 'Trustbread Banneton Sourdough Baking Kit' },
  { src: imgBanneton, alt: 'Rattan banneton basket' },
  { src: imgScale, alt: 'Digital kitchen scale' },
  { src: imgLame, alt: 'Bread lame scoring tool' },
  { src: imgWhisk, alt: 'Danish dough whisk' },
  { src: imgScraper, alt: 'Dough scraper' },
  { src: imgSteps, alt: 'Sourdough baking steps' },
  { src: imgLifestyle, alt: 'Baking with Trustbread kit' },
  { src: imgGift, alt: 'Gift-ready Trustbread kit' },
];

const aboutItems = [
  {
    title: 'THE COMPLETE 9-PIECE KIT:',
    text: 'Includes a handmade 9" rattan banneton with linen liner, wooden bread lame with 5 steel blades, Danish dough whisk, dough scraper, digital kitchen scale, banneton manual and an artisan recipe booklet — everything you need from first mix to finished loaf.',
  },
  {
    title: 'ACCURATE DOUGH STARTS HERE:',
    text: 'The stainless digital scale weighs to 1g precision with 5kg capacity and 6 units, so hydration and starter feedings come out right every time. Dual power: USB-C rechargeable or AAA batteries.',
  },
  {
    title: 'BETTER DOUGH, BETTER BREAD:',
    text: 'Natural Indonesian rattan wicks moisture from the surface and supports the dough evenly during proofing — for a stronger rise and the classic spiral crust on artisan loaves.',
  },
  {
    title: 'PRECISE BREAD SCORING:',
    text: 'The ergonomic wooden lame holds razor-sharp blades at the perfect angle for clean, decorative cuts. Adjustable screws, protective cover and 5 replacement blades included.',
  },
  {
    title: 'MIX & SHAPE WITHOUT MESS:',
    text: 'The Danish dough whisk breaks up clumps for smooth, even dough, while the food-safe scraper handles, divides and shapes — clean cuts every time, easy to rinse off.',
  },
  {
    title: 'THE IDEAL GIFT FOR BAKING LOVERS:',
    text: 'Arrives in an elegant gift-ready box with step-by-step manuals — perfect for beginners and seasoned sourdough bakers alike.',
  },
];

const boxItems = [
  '9" rattan banneton',
  'Linen basket liner',
  'Bread lame + 5 blades',
  'Danish dough whisk',
  'Dough scraper',
  'Digital kitchen scale',
  'USB-C charging cable',
  'Manual & recipe book',
];

const tags = ['Beginner friendly', 'Natural rattan', 'Gift-ready box'];
---

<BaseLayout title="Shop — Trustbread" activeNav="shop" showHeader={true} noBottomPad={true}>
  <header class="shop-head">
    <a href="/home/" class="shop-back" aria-label="Back">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
    <div class="shop-title">Shop</div>
    <div class="shop-badge">Trustbread</div>
  </header>

  <div class="shop-scroll fade-in">
    <section class="shop-gallery">
      <div class="shop-main">
        <div class="shop-bestseller">Bestseller</div>
        {gallery.map((img, i) => (
          <Image
            src={img.src}
            alt={img.alt}
            width={720}
            height={720}
            class:list={['shop-main-img', { active: i === 0 }]}
            data-shop-main={i}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
      <div class="shop-thumbs" role="listbox" aria-label="Product images">
        {gallery.map((img, i) => (
          <button
            type="button"
            class:list={['shop-thumb', { active: i === 0 }]}
            data-shop-thumb={i}
            aria-label={`Show image ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <Image src={img.src} alt="" width={104} height={104} class="shop-thumb-img" loading="lazy" />
          </button>
        ))}
      </div>
    </section>

    <section class="shop-info">
      <h1 class="shop-product-name">Trustbread Banneton Sourdough Baking Kit</h1>
      <p class="shop-product-sub">9" rattan proofing basket · digital scale · complete starter set</p>
      <div class="shop-rating">
        <div class="shop-stars" aria-hidden="true">★★★★★</div>
        <div class="shop-rating-score">4.8</div>
        <a href={amazonUrl} target="_blank" rel="noopener" class="shop-rating-link">2,341 ratings on Amazon</a>
      </div>
      <div class="shop-tags">
        {tags.map((tag) => <span class="shop-tag">{tag}</span>)}
      </div>
    </section>

    <section class="shop-about">
      <h2 class="shop-section-title">About the product</h2>
      <ul class="shop-about-list">
        {aboutItems.map((item) => (
          <li>
            <strong>{item.title}</strong> {item.text}
          </li>
        ))}
      </ul>
    </section>

    <section class="shop-box">
      <h2 class="shop-section-title">What’s in the box</h2>
      <div class="shop-box-grid">
        {boxItems.map((label) => (
          <div class="shop-box-item" style="color: var(--brand-primary)">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="7" fill="currentColor"></circle>
              <path d="M4 7.2L6.2 9.4L10 5" stroke="var(--brand-secondary)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span style="color: var(--tb-ink)">{label}</span>
          </div>
        ))}
      </div>
      <p class="shop-partner">Trustbread — your partner in every loaf</p>
    </section>
  </div>

  <div class="shop-buybar">
    <Image src={imgHero} alt="" width={92} height={92} class="shop-buybar-img" loading="lazy" />
    <div class="shop-buybar-text">
      <div class="shop-buybar-name">Banneton Sourdough Kit</div>
      <div class="shop-buybar-price">See current price on Amazon</div>
    </div>
    <a href={amazonUrl} target="_blank" rel="noopener" class="shop-buybar-cta">
      View on Amazon
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7H11M11 7L8 4M11 7L8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</BaseLayout>

<style>
.shop-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: calc(14px + env(safe-area-inset-top, 0px)) var(--page-pad-x) 10px;
  background: var(--brand-secondary);
  border-bottom: 1px solid var(--line);
  flex: none;
}
.shop-back {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: color-mix(in srgb, var(--brand-accent) 35%, var(--brand-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-primary);
  text-decoration: none;
  flex-shrink: 0;
}
.shop-title {
  font-family: var(--font-display);
  font-size: 26px;
  letter-spacing: 0.5px;
  color: var(--brand-primary);
  text-transform: uppercase;
  line-height: 1;
  font-weight: 400;
}
.shop-badge {
  margin-left: auto;
  font-size: 12px;
  font-weight: 700;
  color: var(--brand-dark);
  background: color-mix(in srgb, var(--brand-accent) 35%, var(--brand-secondary));
  border-radius: 999px;
  padding: 5px 10px;
}

.shop-scroll {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  background: var(--brand-secondary);
  padding-bottom: calc(76px + var(--nav-height) + var(--nav-inset-bottom) + 16px + env(safe-area-inset-bottom, 0px));
}

.shop-gallery { padding: 14px 16px 0; }
.shop-main {
  background: var(--tb-card);
  border: 1px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  min-height: 280px;
  aspect-ratio: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.shop-bestseller {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--brand-primary);
  color: var(--brand-secondary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border-radius: 6px;
  padding: 5px 9px;
  z-index: 2;
}
.shop-main :global(.shop-main-img) {
  position: relative;
  inset: auto;
  width: 100%;
  height: auto;
  max-height: 520px;
  object-fit: contain;
  background: var(--tb-card);
  display: none;
}
.shop-main :global(.shop-main-img.active) { display: block; }

.shop-thumbs {
  display: flex;
  gap: 8px;
  margin-top: 10px;
  overflow-x: auto;
  padding-bottom: 4px;
}
.shop-thumbs::-webkit-scrollbar { display: none; }
.shop-thumb {
  width: 52px;
  height: 52px;
  flex: none;
  border-radius: 10px;
  padding: 0;
  overflow: hidden;
  cursor: pointer;
  background: var(--tb-card);
  border: 2px solid transparent;
}
.shop-thumb.active { border-color: var(--brand-primary); }
.shop-thumb :global(.shop-thumb-img) {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  background: var(--tb-card);
}

.shop-info { padding: 14px 16px 0; }
.shop-product-name {
  font-family: var(--font-display);
  font-size: 26px;
  line-height: 1.08;
  color: var(--tb-ink);
  text-transform: uppercase;
  letter-spacing: 0.3px;
  font-weight: 400;
}
.shop-product-sub {
  font-size: 14px;
  color: var(--brand-dark);
  margin-top: 4px;
}
.shop-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}
.shop-stars {
  color: var(--brand-accent);
  font-size: 14px;
  letter-spacing: 1px;
  line-height: 1;
}
.shop-rating-score {
  font-size: 13px;
  font-weight: 700;
  color: var(--tb-ink);
}
.shop-rating-link {
  font-size: 13px;
  color: var(--brand-primary);
  text-decoration: underline;
}
.shop-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 10px;
}
.shop-tag {
  font-size: 12px;
  font-weight: 700;
  color: var(--brand-primary);
  background: color-mix(in srgb, var(--brand-accent) 40%, var(--brand-secondary));
  border-radius: 999px;
  padding: 5px 10px;
}

.shop-about,
.shop-box { padding: 18px 16px 0; }
.shop-section-title {
  font-family: var(--font-display);
  font-size: 22px;
  color: var(--brand-primary);
  text-transform: uppercase;
  letter-spacing: 0.4px;
  font-weight: 400;
}
.shop-about-list {
  margin: 10px 0 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 14.5px;
  line-height: 1.5;
  color: var(--tb-ink);
}

.shop-box-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 10px;
}
.shop-box-item {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--tb-card);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 9px 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--tb-ink);
}
.shop-box-item svg { flex: none; }
.shop-box-item :global(circle) { fill: var(--brand-primary); }
.shop-box-item :global(path) { stroke: var(--brand-secondary); }
.shop-partner {
  margin-top: 16px;
  font-size: 12px;
  color: var(--brand-dark);
  text-align: center;
  padding-bottom: 8px;
}

.shop-buybar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(var(--nav-height) + var(--nav-inset-bottom) + 8px + env(safe-area-inset-bottom, 0px));
  width: calc(100% - 16px);
  max-width: calc(480px - 16px);
  border-radius: 18px;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  background: color-mix(in srgb, var(--brand-accent) 45%, var(--brand-secondary));
  border: 1px solid var(--line);
  z-index: 90;
}
.shop-buybar :global(.shop-buybar-img) {
  width: 46px;
  height: 46px;
  object-fit: cover;
  border-radius: 10px;
  background: var(--tb-card);
  flex: none;
}
.shop-buybar-text {
  min-width: 0;
  flex: 1;
}
.shop-buybar-name {
  font-family: var(--font-display);
  font-size: 16px;
  line-height: 1.05;
  color: var(--tb-ink);
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 400;
}
.shop-buybar-price {
  font-size: 12px;
  color: var(--brand-dark);
}
.shop-buybar-cta {
  flex: none;
  display: flex;
  align-items: center;
  gap: 7px;
  background: var(--brand-primary);
  color: var(--brand-secondary);
  font-size: 15px;
  font-weight: 700;
  border-radius: 999px;
  padding: 13px 18px;
  text-decoration: none;
}
.shop-buybar-cta:active { background: var(--brand-light-1); }
</style>

<script>
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-shop-thumb]')];
  const mains = [...document.querySelectorAll<HTMLElement>('[data-shop-main]')];

  function setActive(index: number) {
    thumbs.forEach((thumb, i) => {
      const active = i === index;
      thumb.classList.toggle('active', active);
      thumb.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    mains.forEach((img, i) => img.classList.toggle('active', i === index));
  }

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const index = Number(thumb.dataset.shopThumb ?? 0);
      setActive(index);
    });
  });
</script>
