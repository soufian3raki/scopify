---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureUnavailable from '../components/FeatureUnavailable.astro';
import { isEnabled } from '../config/feature-flags';

const showTimer = isEnabled('timerPage');
---

{!showTimer ? (
  <FeatureUnavailable
    title="Hermann Timer"
    message="The sourdough timer will be available soon."
    activeNav="timer"
  />
) : (
  <BaseLayout title="Hermann Timer — Superbaking" activeNav="timer">
    <div class="fade-in">

      <div class="head">
        <div>
          <div class="head-greet">Hermann</div>
          <div class="head-name">Sourdough Timer</div>
        </div>
        <a href="/profil" class="head-avatar">B</a>
      </div>

      <div class="timer-display">
        <div class="timer-label">Next feed in</div>
        <div class="timer-clock" id="timerClock">02:14:38</div>
        <div class="timer-next">Today, 6:30 PM</div>
      </div>

      {isEnabled('timerActions') && (
        <div class="timer-actions">
          <button class="timer-btn">
            <div class="timer-btn-emoji">🥄</div>
            <div>Fed</div>
          </button>
          <button class="timer-btn">
            <div class="timer-btn-emoji">📸</div>
            <div>Photo</div>
          </button>
          <button class="timer-btn">
            <div class="timer-btn-emoji">📝</div>
            <div>Note</div>
          </button>
        </div>
      )}

      {isEnabled('timerJournal') && (
        <div class="journal">
          <div class="journal-title">Journal</div>
          <div class="journal-entry">
            <div class="journal-date">Today<br/>12:00</div>
            <div class="journal-text">Hermann shows nice bubbles. Doubled in 4 hours — ready to bake!</div>
          </div>
          <div class="journal-entry">
            <div class="journal-date">Yesterday<br/>6:30 PM</div>
            <div class="journal-text">Fed 50g flour + 50g water. Room 23°C.</div>
          </div>
          <div class="journal-entry">
            <div class="journal-date">May 13<br/>6:00 PM</div>
            <div class="journal-text">Baked classic farmhouse bread — best result yet! ⭐</div>
          </div>
          <div class="journal-entry">
            <div class="journal-date">May 12<br/>9:00 AM</div>
            <div class="journal-text">Fed after 24h in the fridge. Hermann is waking up slowly.</div>
          </div>
        </div>
      )}

    </div>
  </BaseLayout>
)}

<style>
.timer-display {
  margin: 0 var(--page-pad-x) 24px; padding: 32px; border-radius: 24px;
  background: linear-gradient(135deg, var(--rye), var(--crust-dark));
  color: var(--paper); text-align: center;
}
.timer-label { font-size: 13px; text-transform: uppercase; letter-spacing: .12em; opacity: .7; margin-bottom: 8px; }
.timer-clock { font-family: var(--font-display); font-size: var(--font-size); font-weight: var(--font-weight); letter-spacing: 0.02em; line-height: var(--line-height); }
.timer-next { font-size: 13px; opacity: .7; margin-top: 8px; }

.timer-actions { margin: 0 var(--page-pad-x) 24px; display: flex; gap: 10px; }
.timer-btn {
  flex: 1; padding: 14px; background: var(--paper); border: 1px solid var(--line);
  border-radius: 14px; font-size: 13px; font-weight: var(--font-weight); color: var(--ink);
  cursor: pointer; font-family: inherit; display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.timer-btn-emoji { font-size: 20px; }

.journal { padding: 0 var(--page-pad-x) 24px; }
.journal-title { font-family: var(--font-display); font-size: var(--font-size); line-height: var(--line-height); font-weight: var(--font-weight); color: var(--ink); margin-bottom: 14px; letter-spacing: 0.02em; }
.journal-entry {
  padding: 14px; background: var(--paper); border: 1px solid var(--line);
  border-radius: 14px; margin-bottom: 10px; display: flex; gap: 12px;
}
.journal-date { font-family: var(--font-display); font-size: 11px; font-weight: var(--font-weight); color: var(--accent); text-transform: uppercase; letter-spacing: .08em; width: 60px; flex-shrink: 0; }
.journal-text { font-size: 13px; color: var(--ink-2); line-height: 1.4; }
</style>

{showTimer && (
  <script>
    let totalSeconds = 2 * 3600 + 14 * 60 + 38;

    function updateTimer() {
      if (totalSeconds <= 0) return;
      totalSeconds--;
      const h = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
      const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
      const s = String(totalSeconds % 60).padStart(2, '0');
      document.getElementById('timerClock').textContent = `${h}:${m}:${s}`;
    }

    setInterval(updateTimer, 1000);
  </script>
)}
