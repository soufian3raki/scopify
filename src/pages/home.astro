---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustbreadHeader from '../components/TrustbreadHeader.astro';
import HomeSubscribe from '../components/HomeSubscribe.astro';

import bannetonImg from '../img/kit/ChatGPT Image Jul 7, 2026, 03_51_48 AM.png';
import lameImg from '../img/kit/ChatGPT Image Jul 11, 2026, 04_56_07 PM.png';

const tabs = [
  { id: 'howtos', label: "How to's", href: '/home/', active: true },
  { id: 'recipes', label: 'Recipes', href: '/rezepte/', active: false },
  { id: 'guide', label: 'Baking guide', href: '/kit/', active: false },
  { id: 'blog', label: 'Blog', href: '/blog/', active: false },
];

const articles = [
  {
    href: '/kit/',
    image: bannetonImg,
    alt: 'Banneton proofing basket',
    date: 'July 10, 2026',
    title: 'How to use your banneton: proofing for a better crust',
    excerpt: 'Natural rattan wicks moisture from the dough surface and supports an even rise — here’s how to flour, fill and turn out your basket…',
  },
  {
    href: '/kit/',
    image: lameImg,
    alt: 'Bread lame scoring tool',
    date: 'July 2, 2026',
    title: 'Scoring 101: clean cuts from a single slash to wheat ears',
    excerpt: 'The right blade angle decides how your loaf opens in the oven. With the Trustbread lame you hold it perfectly by default…',
  },
];

const kitFeatures = [
  {
    title: 'Digital kitchen scale included',
    text: 'The heart of the set: 1g precision, 5kg capacity, 6 units and USB-C charging — accurate dough starts here, every feeding and every hydration.',
    icon: 'scale',
  },
  {
    title: 'Natural & handcrafted',
    text: 'Handmade Indonesian rattan banneton with linen liner — smooth, splinter-free and food-safe for you and your family.',
    icon: 'leaf',
  },
  {
    title: 'Beginner-friendly from day one',
    text: '9 pieces, one system: lame, whisk, scraper, manuals and recipe booklet — designed for first-time success, no experience needed.',
    icon: 'tools',
  },
  {
    title: 'Gift-ready box',
    text: 'Arrives in an elegant box — the ideal gift for baking lovers, beginners and seasoned sourdough bakers alike.',
    icon: 'gift',
  },
];
---

<BaseLayout title="Trustbread — Home" activeNav="home" showHeader={true} noBottomPad={true}>
  <TrustbreadHeader />

  <div class="tb-home-scroll fade-in">
    <section class="tb-hero">
      <p class="tb-hero-script">Real bakers · Real kitchens</p>
      <h1 class="tb-hero-title">Recipes &amp; guides that actually work</h1>
      <p class="tb-hero-lead">
        Whether you’re feeding your very first starter or shaping your hundredth batard — the Trustbread kit and guides take the guesswork out of every loaf.
      </p>
    </section>

    <nav class="tb-tabs" aria-label="Content sections">
      {tabs.map((tab) => (
        <a href={tab.href} class:list={['tb-tab', { active: tab.active }]} aria-current={tab.active ? 'page' : undefined}>
          {tab.label}
        </a>
      ))}
    </nav>

    <section class="tb-articles" aria-label="Guides">
      {articles.map((article) => (
        <a href={article.href} class="tb-article">
          <Image
            src={article.image}
            alt={article.alt}
            width={900}
            height={1200}
            class="tb-article-img"
            loading="lazy"
          />
          <div class="tb-article-body">
            <p class="tb-article-meta">
              <span class="tb-article-author">Your friends at Trustbread</span> · {article.date}
            </p>
            <h2 class="tb-article-title">{article.title}</h2>
            <p class="tb-article-excerpt">{article.excerpt}</p>
          </div>
        </a>
      ))}
    </section>

    <section class="tb-kit" aria-labelledby="kit-heading">
      <p class="tb-kit-script">Inside your kit</p>
      <h2 id="kit-heading" class="tb-kit-title">Why bakers love this set</h2>

      <div class="tb-kit-features">
        {kitFeatures.map((feature) => (
          <div class="tb-kit-feature">
            {feature.icon === 'scale' && (
              <svg class="tb-kit-icon" width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <rect x="5" y="20" width="24" height="8" rx="2" stroke="currentColor" stroke-width="1.9"></rect>
                <rect x="9" y="22.5" width="8" height="3" rx="1" fill="currentColor"></rect>
                <path d="M17 20V13M17 13C17 9 20 7 23 7M17 13C17 9 14 7 11 7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
              </svg>
            )}
            {feature.icon === 'leaf' && (
              <svg class="tb-kit-icon" width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M17 28C11 28 7 24 7 19C7 13 12 7 17 5C22 7 27 13 27 19C27 24 23 28 17 28Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"></path>
                <path d="M17 28V12" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
              </svg>
            )}
            {feature.icon === 'tools' && (
              <svg class="tb-kit-icon" width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M11 8H23L21 26H13L11 8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"></path>
                <path d="M8 8H26" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
                <path d="M14 13L20 21M20 13L14 21" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
              </svg>
            )}
            {feature.icon === 'gift' && (
              <svg class="tb-kit-icon" width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <rect x="6" y="13" width="22" height="14" rx="2" stroke="currentColor" stroke-width="1.9"></rect>
                <path d="M6 18H28" stroke="currentColor" stroke-width="1.9"></path>
                <path d="M13 13V10C13 8.3 14.3 7 16 7H18C19.7 7 21 8.3 21 10V13" stroke="currentColor" stroke-width="1.9"></path>
                <path d="M17 21V24" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
              </svg>
            )}
            <h3 class="tb-kit-feature-title">{feature.title}</h3>
            <p class="tb-kit-feature-text">{feature.text}</p>
          </div>
        ))}
      </div>

      <a href="/shop/" class="tb-kit-cta">See the full kit in the shop →</a>
    </section>

    <HomeSubscribe />

    <footer class="tb-footer">Trustbread — your partner in every loaf</footer>
  </div>
</BaseLayout>

<style>
.tb-home-scroll {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  padding-bottom: calc(var(--nav-height) + var(--nav-inset-bottom) + 16px + env(safe-area-inset-bottom, 0px));
}
.tb-hero {
  padding: 22px var(--page-pad-x) 0;
}
.tb-hero-script {
  font-family: var(--font-script);
  font-size: clamp(22px, 6vw, 28px);
  color: var(--tb-gold);
  line-height: 1;
}
.tb-hero-title {
  font-family: var(--font-display);
  font-size: clamp(28px, 8.5vw, 40px);
  line-height: 0.98;
  color: var(--tb-burgundy);
  text-transform: uppercase;
  margin-top: 10px;
  font-weight: 400;
}
.tb-hero-lead {
  font-size: 14.5px;
  line-height: 1.6;
  color: var(--tb-ink-soft);
  margin-top: 12px;
}

.tb-tabs {
  display: flex;
  justify-content: space-between;
  gap: 4px;
  padding: 20px var(--page-pad-x) 0;
  border-bottom: 1px solid rgba(92, 31, 48, .15);
  margin-bottom: 4px;
}
.tb-tab {
  font-family: var(--font-display);
  font-size: clamp(13px, 4vw, 17px);
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--tb-muted);
  padding: 6px 4px 10px;
  border-bottom: 3px solid transparent;
  text-decoration: none;
  white-space: nowrap;
}
.tb-tab.active {
  color: var(--tb-burgundy);
  border-bottom-color: var(--tb-burgundy);
}

.tb-articles {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 16px var(--page-pad-x) 0;
}
.tb-article {
  background: var(--tb-card);
  border: 1px solid rgba(92, 31, 48, .14);
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: border-color .2s;
}
.tb-article:active { border-color: var(--tb-burgundy); }
.tb-article :global(.tb-article-img) {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  background: var(--brand-secondary);
}
.tb-article-body { padding: 14px 16px 16px; }
.tb-article-meta {
  font-size: 12px;
  color: var(--tb-muted);
}
.tb-article-author {
  color: var(--tb-accent);
  font-weight: 700;
}
.tb-article-title {
  font-family: var(--font-display);
  font-size: 21px;
  line-height: 1.05;
  color: var(--tb-burgundy);
  text-transform: uppercase;
  margin-top: 6px;
  font-weight: 400;
}
.tb-article-excerpt {
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--tb-ink-soft);
  margin-top: 6px;
}

.tb-kit {
  padding: 28px var(--page-pad-x) 0;
  text-align: center;
  margin-bottom: 15px;
}
.tb-kit-script {
  font-family: var(--font-script);
  font-size: 24px;
  color: var(--tb-gold);
  line-height: 1;
}
.tb-kit-title {
  font-family: var(--font-display);
  font-size: 28px;
  color: var(--tb-burgundy);
  text-transform: uppercase;
  line-height: 1;
  margin-top: 8px;
  font-weight: 400;
}
.tb-kit-features {
  display: flex;
  flex-direction: column;
  gap: 22px;
  padding: 20px 12px 0;
}
.tb-kit-feature { text-align: center; }
.tb-kit-icon {
  margin: 0 auto;
  color: var(--tb-burgundy);
  display: block;
}
.tb-kit-feature-title {
  font-family: var(--font-display);
  font-size: 18px;
  color: var(--tb-burgundy);
  text-transform: uppercase;
  margin-top: 8px;
  line-height: 1.1;
  font-weight: 400;
}
.tb-kit-feature-text {
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--tb-ink-soft);
  margin-top: 4px;
}
.tb-kit-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin: 20px 16px 0;
  background: var(--tb-burgundy);
  color: var(--tb-cream);
  font-size: 15px;
  font-weight: 700;
  border-radius: 999px;
  padding: 14px 18px;
  text-decoration: none;
}
.tb-kit-cta:active { background: var(--tb-burgundy-hover); }

.tb-footer {
  background: var(--tb-burgundy);
  padding: 14px 22px;
  text-align: center;
  font-size: 12px;
  color: var(--tb-footer-text);
}
</style>
