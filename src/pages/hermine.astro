---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureUnavailable from '../components/FeatureUnavailable.astro';
import { isEnabled } from '../config/feature-flags';

const showHermine = isEnabled('herminePage');
---

{!showHermine ? (
  <FeatureUnavailable
    title="Hermine — AI Coach"
    message="The AI coach will be available soon."
    showNav={false}
  />
) : (
  <BaseLayout title="Hermine — AI Coach — Superbaking" showNav={false}>
    <div class="fade-in">

      <div class="page-head">
        <a href="/home/" class="page-back">←</a>
      </div>

      <div class="hermine-hero">
        <div class="hermine-avatar">🤖</div>
        <div class="hermine-name">Hermine</div>
        <div class="hermine-role">Your AI baking coach</div>
      </div>

      <div class="upload-card">
        <div class="upload-icon">📸</div>
        <div class="upload-title">Upload a photo</div>
        <div class="upload-desc">Starter, dough, or finished bread — Hermine will analyse it for you</div>
      </div>

      <div class="suggestions">
        <div class="suggest-title">Common questions</div>
        <div class="suggest-item">My starter isn't rising — what should I do?</div>
        <div class="suggest-item">How do I know when my dough is ready?</div>
        <div class="suggest-item">My bread tastes too sour</div>
        <div class="suggest-item">How do I get a better crust?</div>
        <div class="suggest-item">Which flour for which bread?</div>
      </div>

    </div>
  </BaseLayout>
)}

<style>
@keyframes rotate { to { transform: rotate(360deg); } }

.hermine-hero {
  margin: 0 var(--page-pad-x) 24px; padding: 24px var(--page-pad-x); border-radius: 24px;
  background: linear-gradient(135deg, #591727, #3d0f1a);
  color: var(--paper); text-align: center; position: relative; overflow: hidden;
}
.hermine-hero::before {
  content: ""; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: radial-gradient(circle, rgba(225, 171, 123, .2), transparent 40%);
  animation: rotate 20s linear infinite;
}
.hermine-avatar {
  width: 80px; height: 80px; border-radius: 50%;
  background: linear-gradient(135deg, var(--yeast), var(--accent));
  display: flex; align-items: center; justify-content: center;
  font-size: 40px; margin: 0 auto 14px; position: relative; z-index: 1;
  box-shadow: 0 8px 32px rgba(225, 171, 123, .4);
}
.hermine-name { font-family: var(--font-display); font-size: var(--font-size); line-height: var(--line-height); font-weight: var(--font-weight); letter-spacing: 0.02em; margin-bottom: 6px; position: relative; z-index: 1; }
.hermine-role { font-size: 13px; opacity: .7; position: relative; z-index: 1; }

.upload-card {
  margin: 0 var(--page-pad-x) 20px; padding: 24px var(--page-pad-x); border-radius: 20px;
  background: var(--paper); border: 2px dashed var(--line);
  text-align: center; cursor: pointer; transition: all .2s;
}
.upload-card:hover { border-color: var(--accent); background: var(--paper); }
.upload-icon { font-size: 40px; margin-bottom: 8px; }
.upload-title { font-family: var(--font-display); font-size: var(--font-size); line-height: var(--line-height); font-weight: var(--font-weight); color: var(--ink); margin-bottom: 4px; }
.upload-desc { font-size: 12px; color: var(--muted); }

.suggestions { padding: 0 var(--page-pad-x) 24px; }
.suggest-title { font-size: 13px; font-weight: var(--font-weight); color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 12px; }
.suggest-item {
  padding: 14px 16px; background: var(--paper); border: 1px solid var(--line);
  border-radius: 14px; margin-bottom: 10px; font-size: 13px; color: var(--ink-2);
  cursor: pointer; display: flex; align-items: center; gap: 10px; transition: transform .2s;
}
.suggest-item:active { transform: scale(.98); }
.suggest-item::before { content: "💭"; font-size: 18px; }
</style>
